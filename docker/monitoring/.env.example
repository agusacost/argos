# Copiar este archivo como .env y completar con valores reales.
# .env está en .gitignore — nunca commitear credenciales reales.

# ─── Alertmanager / n8n: SMTP ─────────────────────────────────────────────────
# Editar alertmanager/alertmanager.yml con los valores correspondientes.
# Si usás Gmail, generá un App Password en:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=observabilidad@example.com
SMTP_TO=alerts@example.com
SMTP_USER=observabilidad@example.com
SMTP_PASSWORD=your_app_password_here

# ─── Grafana: SMTP para notificaciones nativas (opcional) ────────────────────
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=observabilidad@example.com
GF_SMTP_PASSWORD=your_app_password_here
GF_SMTP_FROM_ADDRESS=observabilidad@example.com
GF_SMTP_FROM_NAME=Grafana Observabilidad

# ─── n8n: Orquestación inteligente (Sprint 4) ────────────────────────────────
# Generar con PowerShell:
#   [System.BitConverter]::ToString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).Replace('-','').ToLower()
N8N_ENCRYPTION_KEY=replace-with-64-char-random-hex-string

# ─── Proveedor LLM principal (gemini | anthropic | groq | openrouter) ─────────
# Default hasta que se elija otro en Configuración del dashboard. Lo llama rag-api (n8n ya no usa keys de LLM).
LLM_PROVIDER=gemini

# ─── Google Gemini API (opción A — recomendada si tenés key de Gemini) ────────
# Generar en https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Modelo: gemini-flash-latest (alias auto-actualizable, evita deprecaciones) | gemini-pro-latest
GEMINI_MODEL=gemini-flash-latest

# ─── Anthropic Claude API (opción B — si tenés key de Anthropic) ──────────────
# Generar en https://console.anthropic.com/ — NO commitear la key real.
ANTHROPIC_API_KEY=sk-ant-replace-with-real-api-key
# Modelo Claude: claude-sonnet-4-6 (balance) | claude-opus-4-8 (máxima capacidad)
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Respaldo gratuito (API compatible con OpenAI) ────────────────────────────
# Groq: key gratis sin tarjeta en https://console.groq.com/keys (≈30 req/min, ≈1000 req/día en modelos 70B).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter: key en https://openrouter.ai/keys. Modelos ':free' (≈20 req/min; 50 req/día sin crédito,
# 1000/día si alguna vez cargaste US$10). Modelo fijo: el router 'openrouter/free' a veces elige un clasificador de
# seguridad (nemotron-3.5-content-safety) que responde solo "User Safety: safe" (evaluación OE3, 2026-10-27).
# El catálogo free rota: si este modelo devuelve 404, elegir otro en https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ─── Fallback y salud de los LLM ──────────────────────────────────────────────
# Después del proveedor principal se prueba esta cadena en orden (proveedor[:modelo], coma-separado).
# Los eslabones sin API key se saltean. gemini-flash-lite usa la misma GEMINI_API_KEY con otra cuota.
LLM_FALLBACK_CHAIN=gemini:gemini-flash-lite-latest,groq,openrouter
# Segundos que un proveedor que falló (429/5xx/timeout) queda al final de la cadena antes de reintentarlo.
LLM_COOLDOWN_SECONDS=300

# ─── RAG API (Sprint 3/4/5) ───────────────────────────────────────────────────
# URL interna del microservicio RAG dentro de argos-net (consumido por n8n y dashboard).
RAG_API_URL=http://rag-api:8000
# Umbral de similitud: score > este valor = incidente ya documentado.
# MiniLM multilingual da scores más bajos que otros modelos (~0.5–0.65).
SIMILARITY_THRESHOLD=0.63
# Orígenes permitidos por CORS en rag-api (coma-separados). '*' = cualquiera (dev).
# En prod el dashboard usa proxy nginx same-origin, así que CORS casi no se ejercita.
CORS_ORIGINS=*

# ─── Dashboard de Argos (Sprint 5) ────────────────────────────────────────────
# Puerto host del panel propio (SPA React). http://localhost:<DASHBOARD_PORT>
DASHBOARD_PORT=3001

# ─── Seed automático de datos en rag-api ──────────────────────────────────────
# Al arrancar, rag-api carga los runbooks de knowledge/ en Qdrant (no se duplican).
# ARGOS_SEED_DEMO=true agrega 15 incidentes demo con fechas relativas al arranque: se reescriben en cada
# reinicio (parecen siempre recientes), así que solo conviene para una demo sin datos reales.
ARGOS_AUTO_SEED=true
ARGOS_SEED_DEMO=false

# ─── Disparo del flujo inteligente ────────────────────────────────────────────
# Cantidad de alertas activas en el grupo que dispara el análisis con Claude.
ALERT_THRESHOLD=3
# Destinatario FALLBACK de las notificaciones enriquecidas de n8n. El pool real de destinatarios
# se configura desde el dashboard (Configuración → Notificaciones por email) y se guarda en Qdrant;
# esta dirección solo se usa si el pool está vacío o rag-api no responde.
ALERT_RECIPIENT_EMAIL=alerts@example.com
# Secreto compartido rag-api ↔ n8n (header X-Argos-Token) para los endpoints internos que usa n8n:
# /query, /upsert, /internal/config y /notifications/recipients. Vacío = abiertos (no recomendado).
# Generar uno con: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Al cambiarlo: recrear argos-api y n8n (el workflow lo lee de $env, no hace falta re-importarlo).
ARGOS_INTERNAL_TOKEN=
