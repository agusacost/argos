<Project Sdk="Microsoft.Build.Sql/2.1.0">
  <PropertyGroup>
    <Name>MembresiaDB</Name>
    <ProjectGuid>{983d525d-97ec-a28f-9ed8-27abde26214e}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <TargetFramework>netstandard2.1</TargetFramework>
    <TargetDatabaseSet>True</TargetDatabaseSet>
    <UseSqlPublish>true</UseSqlPublish>
    <!-- Deshabilita el glob automático del SDK. VS gestiona los <Build Include> explícitamente.
         Sin esto el SDK duplica los items y genera el error 01022. -->
    <EnableDefaultSqlItems>false</EnableDefaultSqlItems>
  </PropertyGroup>
  <!--
    Visual Studio puede cargar SqlBuildTask desde IDE\Extensions\...\DAC (DACFX antiguo) mientras los .targets
    vienen del paquete Microsoft.Build.Sql (más nuevos). Eso provoca error 04064 en parámetros que el task
    viejo no conoce. Forzar SSDTPath al tools\net472 del mismo paquete del SDK alinea task y targets.
  -->
  <PropertyGroup>
    <NuGetPackageRoot Condition="'$(NuGetPackageRoot)' == ''">$(USERPROFILE)\.nuget\packages\</NuGetPackageRoot>
    <SSDTPath>$(NuGetPackageRoot)microsoft.build.sql\$(MicrosoftBuildSqlVersion)\tools\net472</SSDTPath>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Tables\" />
    <Folder Include="Stored Procedures\" />
    <Folder Include="Schemas\" />
    <Folder Include="PostDeployment\" />
    <Folder Include="publish\" />
  </ItemGroup>
  <ItemGroup>
    <PostDeploy Include="PostDeployment\TestData.sql" />
  </ItemGroup>
  <ItemGroup>
    <SqlPublishProfile Include="publish\MembresiaDB.publish.xml" />
    <SqlPublishProfile Include="publish\RemoteMembresiaDB.publish.xml" />
  </ItemGroup>
  <!-- Los .sql de Schemas/, Tables/ y Stored Procedures/ los incluye el SDK por glob automaticamente.
       NO repetir con <Build Include="..."> o se genera el error 01022 de items duplicados. -->
  <ItemGroup>
    <Build Include="Schemas\membresia.sql" />
    <Build Include="Stored Procedures\sp_ObtenerUsuariosPaginado.sql" />
    <Build Include="Tables\Usuarios.sql" />
  </ItemGroup>
</Project>