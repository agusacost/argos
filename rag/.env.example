# Qdrant
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=incidentes

# Embeddings locales (FastEmbed — sin API key, offline tras la 1ra descarga del modelo)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VECTOR_SIZE=384
DISTANCE=Cosine

# Umbral de similitud: score > SIMILARITY_THRESHOLD = incidente documentado
# MiniLM multilingual suele dar scores más bajos que Voyage; ajustar según query_demo outputs.
SIMILARITY_THRESHOLD=0.63
