#!/usr/bin/env bash
# Generado por Terraform (módulo argos-bootstrap). Corre como root una sola vez (cloud-init),
# después de 01-base.sh. Log: /var/log/argos-deploy.log
set -euo pipefail
exec > >(tee -a /var/log/argos-deploy.log) 2>&1

log() { echo "[deploy] $(date -Is) $*"; }

install -d -m 0700 /etc/argos

# ─── Secretos: .env de la plataforma (fuera del repo, solo root) ─────────────
umask 077
echo '${env_file_b64}' | base64 -d > /etc/argos/argos.env
chmod 600 /etc/argos/argos.env

cat > /etc/argos/deploy.conf <<'CONF'
REPO_URL='${repo_url}'
REPO_REF='${repo_ref}'
COMPOSE_PROJECT='${compose_project}'
APP_DIR=/opt/argos
CONF
umask 022

# ─── argos-deploy: re-ejecutable para actualizar el código (sudo argos-deploy) ─
cat > /usr/local/bin/argos-deploy <<'DEPLOY'
#!/usr/bin/env bash
set -euo pipefail
. /etc/argos/deploy.conf

if [ ! -d "$APP_DIR/.git" ]; then
  git init -q "$APP_DIR"
  git -C "$APP_DIR" remote add origin "$REPO_URL"
fi
git -C "$APP_DIR" fetch --depth 1 origin "$REPO_REF"
git -C "$APP_DIR" checkout --force FETCH_HEAD
echo "[argos-deploy] código en $(git -C "$APP_DIR" rev-parse --short HEAD) ($REPO_REF)"

# Compose lee docker/monitoring/.env para interpolar el stack monitoring (incluido por el compose raíz).
install -m 600 /etc/argos/argos.env "$APP_DIR/docker/monitoring/.env"

docker network inspect argos-net >/dev/null 2>&1 || docker network create argos-net

cd "$APP_DIR"
docker compose -p "$COMPOSE_PROJECT" up -d --build --remove-orphans
docker compose -p "$COMPOSE_PROJECT" ps
DEPLOY
chmod 755 /usr/local/bin/argos-deploy

log "Desplegando la plataforma (primer build: varios minutos)..."
/usr/local/bin/argos-deploy

# ─── n8n: importar y activar el workflow versionado (best effort) ────────────
# La credencial SMTP del nodo "Notify Email" se crea a mano en la UI (ver README).
log "Esperando a que argos-n8n esté healthy..."
for _ in $(seq 1 60); do
  status="$(docker inspect -f '{{.State.Health.Status}}' argos-n8n 2>/dev/null || true)"
  [ "$status" = "healthy" ] && break
  sleep 10
done

if [ "$${status:-}" = "healthy" ]; then
  if docker exec argos-n8n n8n import:workflow --input=/workflows/alert-analysis.json \
    && docker exec argos-n8n n8n update:workflow --id=argos-alert-analysis --active=true; then
    docker restart argos-n8n
    log "Workflow de n8n importado y activo."
  else
    log "WARN: no se pudo importar el workflow de n8n (importarlo a mano, ver README)."
  fi
else
  log "WARN: argos-n8n no llegó a healthy; importar el workflow a mano (ver README)."
fi

log "Listo."
