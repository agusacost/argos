{
  "name": "argos-dashboard",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Dashboard propio de Argos (Next.js) — historial de incidentes, métricas (MTTR) y base de conocimiento.",
  "scripts": {
    "dev": "next dev -p 3001",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "test:e2e": "playwright test --grep-invert \"@llm|@k6\"",
    "test:e2e:full": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.446.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.4"
  }
}
